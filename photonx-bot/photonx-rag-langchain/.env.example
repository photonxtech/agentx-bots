# =============================================================================
# PhotonX RAG (LangChain edition) — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
CHROMA_DB=./chroma_db
CHROMA_COLLECTION=photonx_docs_lc

# --- Documents ---
DOCS_DIR=./docs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- Generation ---
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# --- Logging ---
LOG_LEVEL=INFO

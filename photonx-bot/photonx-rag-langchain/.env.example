# =============================================================================
# PhotonX RAG (LangChain edition) — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
CHROMA_DB=./chroma_db
CHROMA_COLLECTION=photonx_docs_lc

# --- Documents ---
DOCS_DIR=./docs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- Generation ---
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployment ---
# Rebuild the vector index at boot when it's empty. Leave false locally (your
# chroma_db persists); set true on hosts with an ephemeral disk, like Render.
INGEST_ON_STARTUP=false

# =============================================================================
# PhotonX RAG — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# --- OpenAI ---
# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Chat model used to synthesize the final answer.
OPENAI_MODEL=gpt-4.1

# Embedding model used to vectorize chunks and queries.
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
# On-disk location for the ChromaDB persistent client.
CHROMA_DB=./chroma_db

# Collection name inside ChromaDB.
CHROMA_COLLECTION=photonx_docs

# --- Documents ---
# Folder scanned by /ingest for PDF files.
DOCS_DIR=./docs

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- Generation ---
# Keep low for factual, non-creative answers.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

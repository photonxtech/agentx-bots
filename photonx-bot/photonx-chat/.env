# Backend URLs the UI can switch between (toggle in the header).
# 127.0.0.1 (not localhost): a Saleor container also listens on :8001 via IPv6,
# and "localhost" resolves to [::1] first, which reaches Saleor instead of the
# LangChain backend. Forcing IPv4 pins these to the uvicorn processes.
VITE_MANUAL_URL=http://127.0.0.1:8000
VITE_LANGCHAIN_URL=http://127.0.0.1:8001

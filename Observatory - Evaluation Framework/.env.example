# Observatory — Evaluation Framework
#
# Copy to .env and fill in. NEVER commit the filled-in file: this repository is
# public. In AWS these values come from Secrets Manager, not from a file — see
# DEPLOY.md; the container reads them as environment variables either way.

# ── Database ──────────────────────────────────────────────────────────────
# Local: a docker-compose Postgres. AWS: injected from the RDS secret.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_eval

# ── File uploads ──────────────────────────────────────────────────────────
# On AWS this points at the EFS mount so uploads survive a task restart.
UPLOAD_DIR=./uploads

# ── Retrieval index cache ─────────────────────────────────────────────────
# ChromaDB's persistent directory. On AWS this is on EFS.
RAG_INDEX_CACHE_DIR=./.rag_index_cache

# ── FastEmbed model cache ─────────────────────────────────────────────────
# Baked into the image at /opt/models so a cold start does not re-download
# ~67MB of ONNX weights. Left unset locally, FastEmbed uses the system temp
# directory, which Windows Disk Cleanup can wipe.
FASTEMBED_CACHE_PATH=./model_cache
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── Groq (required) ───────────────────────────────────────────────────────
# Generation and judging both run on Groq. A second key from a DIFFERENT Groq
# organisation roughly doubles the effective rate limit; the pool fails over
# automatically on 429/401/403.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

# The judge. One constant on purpose — metric scores only compare across runs
# when the model producing them is held fixed.
DEEPEVAL_MODEL=openai/gpt-oss-120b
DEEPEVAL_MODEL_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-20b

# ── Optional: OpenAI-compatible gateway (OmniRoute) ───────────────────────
# Adds provider failover beneath key rotation for answer generation. Blank =
# talk to Groq directly. Health-probed, so an unreachable gateway falls back to
# Groq instead of failing the run.
LLM_GATEWAY_URL=
LLM_GATEWAY_TOKEN=

# Last-resort judge on that gateway, used only once every Groq model is
# exhausted. Must be an auto/* alias — pinning a specific free model disables
# the fallback routing and gets rate-limited immediately.
GATEWAY_JUDGE_MODEL=auto/best-free

# ── Optional: experiment tracing ──────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=observatory-eval

# ── Optional: Collinear VERITAS hallucination detection ───────────────────
COLLINEAR_API_KEY=
COLLINEAR_API_URL=https://api.collinear.ai

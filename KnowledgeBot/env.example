# Slack app credentials (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Groq API key (from console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Models (Groq's lineup rotates fairly often — check
# console.groq.com/docs/models and /docs/vision if these ever 404)
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Where Chroma persists its local data
CHROMA_PATH=./chroma_data

# How similar a stored chunk must be to a question to count as a real
# match (cosine distance: 0 = identical, 2 = opposite). Lower = stricter
# (fewer but more relevant answers), higher = looser (more answers, more
# risk of citing something unrelated). 0.45 is a reasonable starting point.
RELEVANCE_THRESHOLD=0.45

# Optional: Redis connection string for content caching (skips re-doing
# extraction/OCR/summarization if the same URL or file content is seen
# again). If unset, the bot works exactly the same, just without the
# speed-up — this is a pure optimization, never required.
# For a hosted option with no local install (recommended on Windows,
# since native Redis isn't well-supported there): https://upstash.com
# free tier gives you a connection string in this exact format.
# REDIS_URL=redis://default:yourpassword@your-host:6379

# Copy this file to ".env" and fill in your key.
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=YOUR_API_KEY

# Optional: a second Groq key dedicated to RAGAS judge calls (rag/evaluation.py),
# so evaluation traffic has its own rate limit separate from answer generation.
# If unset, evaluation falls back to GROQ_API_KEY above.
GROQ_API_KEY_RAGAS=YOUR_SECOND_API_KEY

# Optional: Postgres connection string for logging Q&A turns + the 6 RAGAS
# metrics (see backend/db.py). If unset, this logging is simply skipped.
DATABASE_URL=postgresql://user:password@localhost:5432/multirag

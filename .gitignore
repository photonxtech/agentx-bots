# =========================================================
# EVALUATION OUTPUTS
# =========================================================

# Generated evaluation results
eval/*.csv
eval/*.json

evaluation/*.csv
evaluation/*.json

# Keep manually created benchmark/ground-truth templates
!eval/ground_truth_template.csv
!evaluation/ground_truth_template.csv

# evaluation/benchmark_120.json is curated benchmark data (120 hand-built
# query/answer/context entries), not a generated run output — exempt it
# from the evaluation/*.json blanket ignore above.
!evaluation/benchmark_*.json


